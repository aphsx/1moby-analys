# Copy to .env. Every variable here is read by the code; commented ones show their default.

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_DB=moby
POSTGRES_USER=moby
POSTGRES_PASSWORD=moby1234
DATABASE_URL=postgresql://moby:moby1234@db:5432/moby

# ── Redis (train import progress stream) ─────────────────────
REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_URL=redis://redis:6379   # takes precedence over REDIS_HOST / REDIS_PORT

# ── api (Elysia) ──────────────────────────────────────────────
# PORT=3001
# Next.js (port 3000) is the allowed browser origin for Elysia's CORS
ALLOWED_ORIGINS=http://localhost:3000
# Internal service token — shared between Elysia and FastAPI for /internal/* routes
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-secret
# Elysia uses this to reach FastAPI internally (Docker service name)
ML_INTERNAL_URL=http://ml:8000
# Timeout for Elysia → FastAPI internal calls (ms).
ML_INTERNAL_TIMEOUT_MS=30000
# Runs stuck in a non-terminal status longer than this are marked failed.
STALE_RUN_TIMEOUT_MINUTES=120
# Upload size cap and wall-clock budget for one import (raw + clean).
# IMPORT_MAX_UPLOAD_BYTES=1073741824
# IMPORT_TIMEOUT_MS=600000

# ── web (Next.js) ─────────────────────────────────────────────
# The Next.js proxy rewrites /api/* to this URL (Docker internal)
ELYSIA_URL=http://api:3001
# Browser-visible origin for the Better Auth client (the Next.js URL)
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# ── Better Auth ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-string
# Public-facing URL used for OAuth callbacks. Auth flows through the Next.js proxy
# (/api/auth/*), so this is the Next.js URL. Do NOT set NEXT_PUBLIC_BETTER_AUTH_URL.
BETTER_AUTH_URL=http://localhost:3000
# Google → https://console.cloud.google.com/apis/credentials
# Redirect URI to register: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM — Gen AI (/customers) + AI Chat (/ai-chat) ────────────
#   LLM_PROVIDER  openai | ollama  (default: ollama)
#   LLM_API_KEY   API key / Bearer token
#   LLM_BASE_URL  Base URL without trailing slash
#   LLM_MODEL     Chat model
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=https://ollama.com
LLM_MODEL=qwen3.5:397b-cloud
# Legacy Ollama names, used when the LLM_* value is unset:
OLLAMA_API_KEY=
OLLAMA_HOST=
OLLAMA_MODEL=

# ── ml (FastAPI + training / prediction CLIs) ─────────────────
MODEL_DIR=/app/models
# ML_HOST=0.0.0.0   # docker-compose sets this; Railway (IPv6-only) can use ::
# ML_PORT=8000
# Churn candidates that compete in training (comma-separated).
# CHURN_CANDIDATES=logistic_regression,lightgbm,tabicl
# TabICL picks CUDA → MPS → CPU automatically; force one with cuda | mps | cpu.
# TABICL_DEVICE=
# TABICL_MAX_ROWS=2000   # caps TabICL's in-context rows
# Credit: LGBM vs XGBoost quantile competition per horizon. Set 0 to skip XGBoost.
# ENABLE_XGB_CREDIT=1
# Build arg for the ml image: cpu (default) or cuda.
# TORCH_VARIANT=cpu
